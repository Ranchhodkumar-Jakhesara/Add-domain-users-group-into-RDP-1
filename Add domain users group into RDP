# Enable Remote Desktop
Set-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\Terminal Server' -Name "fDenyTSConnections" -Value 0

# Allow RDP in Windows Firewall
Enable-NetFirewallRule -DisplayGroup "Remote Desktop"

# Add 'Domain Users' to the Remote Desktop Users group
try {
    $group = [ADSI]"WinNT://$env:COMPUTERNAME/Remote Desktop Users,group"
    $domainUsers = "Domain Users"
    $domain = $env:USERDOMAIN
    $user = "WinNT://$domain/$domainUsers,group"
    $group.Add($user)
    Write-Host "'Domain Users' group successfully added to 'Remote Desktop Users'."
}
catch {
    Write-Host "Failed to add 'Domain Users' group. Error: $_"
}
